  <office:body>
    <office:text>
      <text:p text:style-name="Title">Angebot Dachsanierung Haus Nr. 12</text:p>
      <text:p text:style-name="Text_20_body">Angebot nach Besichtigung<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Besichtigung am 9. Oktober 2026 mit dem Eigentümer.</text:p></text:note-body></text:note> vom 10. Oktober 2026 für das Objekt <text:span text:style-name="Strong_20_Emphasis">Haus Nr. 12</text:span>.</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="Leistung"/>Leistung</text:h>
      <text:p text:style-name="Text_20_body">Die Arbeiten umfassen Abdeckung, Lattung und Eindeckung des Satteldachs mit einer Fläche von 120 m<text:span text:style-name="T1">2</text:span>; die Eindeckung ist CO<text:span text:style-name="T2">2</text:span>-neutral hergestellt.</text:p>
      <text:list text:style-name="List_20_1">
        <text:list-item>
          <text:p text:style-name="List_20_Contents">Abdeckung</text:p>
          <text:list>
            <text:list-item><text:p text:style-name="List_20_Contents">Ziegel abnehmen</text:p></text:list-item>
            <text:list-item>
              <text:p text:style-name="List_20_Contents">Lattung prüfen</text:p>
              <text:list>
                <text:list-item><text:p text:style-name="List_20_Contents">Schadhafte Latten ersetzen</text:p></text:list-item>
              </text:list>
            </text:list-item>
          </text:list>
        </text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Eindeckung</text:p></text:list-item>
      </text:list>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Ablauf</text:h>
      <text:list text:style-name="Numbering_20_123">
        <text:list-item><text:p text:style-name="List_20_Contents">Gerüst stellen</text:p></text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Abdecken und Lattung prüfen</text:p></text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Eindecken</text:p></text:list-item>
      </text:list>
      <text:p text:style-name="Text_20_body">Nach der Abnahme durch den Auftraggeber:</text:p>
      <text:list text:style-name="Numbering_20_123" text:continue-numbering="true">
        <text:list-item><text:p text:style-name="List_20_Contents">Gerüst abbauen</text:p></text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Baustelle räumen</text:p></text:list-item>
      </text:list>
      <text:h text:style-name="P2" text:outline-level="2">Hinweis zur Statik</text:h>
      <text:p text:style-name="Quotations">„Die Sparren sind tragfähig; an der Nordseite gibt es Feuchteschäden.“ (Zustandsbericht vom 9. Oktober 2026)</text:p>
      <text:p text:style-name="Preformatted_20_Text">Woche 1: Abdeckung<text:line-break/>Woche 2: Eindeckung</text:p>
      <text:p text:style-name="P1">Dieser Absatz ist nur direkt fett und groß formatiert. Er ist keine Überschrift und bleibt ein Absatz.</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Positionen</text:h>
      <table:table table:name="Positionen" table:style-name="Positionen">
        <table:table-column table:number-columns-repeated="3"/>
        <table:table-header-rows>
          <table:table-row>
            <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Heading">Position</text:p></table:table-cell>
            <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Heading">Menge</text:p></table:table-cell>
            <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Heading">Betrag</text:p></table:table-cell>
          </table:table-row>
        </table:table-header-rows>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Abdeckung</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">120 m²</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">2.400,00 EUR</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" office:value-type="string"><text:p text:style-name="Table_20_Contents">Eindeckung</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Ziegel 120 m²</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">9.600,00 EUR</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Firstziegel 14 m</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">560,00 EUR</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="2" office:value-type="string"><text:p text:style-name="Table_20_Contents">Summe netto</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">12.560,00 EUR</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Table">Tabelle <text:sequence text:ref-name="refTable0" text:name="Table" text:formula="ooow:Table+1" style:num-format="1">1</text:sequence>: Positionen mit Mengen und Beträgen</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Skizze</text:h>
      <text:p text:style-name="Text_20_body">
        <draw:frame draw:style-name="fr1" draw:name="Rahmen1" text:anchor-type="paragraph" svg:width="4.8cm" svg:height="2.9cm" draw:z-index="0">
          <draw:text-box>
            <text:p text:style-name="Illustration">
              <draw:frame draw:style-name="fr2" draw:name="Bild1" text:anchor-type="as-char" svg:width="4.8cm" svg:height="2.4cm" draw:z-index="1">
                <draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADAAAAAYCAIAAAAzn+mLAAAANUlEQVR42mPQztlAI/SMLMAw6qBRB406aNRBow4addCog0YdNAgd9IyOYNRBow4addCIcxAAb4fwubOOsmoAAAAASUVORK5CYII=</office:binary-data></draw:image>
                <svg:title>Balkendiagramm: Dachfläche Nord 62,5 m², Dachfläche Süd 57,5 m²</svg:title>
              </draw:frame>
              Abbildung <text:sequence text:ref-name="refIllustration0" text:name="Illustration" text:formula="ooow:Illustration+1" style:num-format="1">1</text:sequence>: Flächen je Dachseite
            </text:p>
          </draw:text-box>
        </draw:frame>
      </text:p>
      <text:p text:style-name="Text_20_body">
        <draw:frame draw:style-name="fr2" draw:name="Zierlinie" draw:decorative="true" text:anchor-type="as-char" svg:width="4.8cm" svg:height="0.6cm" draw:z-index="2">
          <draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADAAAAAYCAIAAAAzn+mLAAAANUlEQVR42mPQztlAI/SMLMAw6qBRB406aNRBow4addCog0YdNAgd9IyOYNRBow4addCIcxAAb4fwubOOsmoAAAAASUVORK5CYII=</office:binary-data></draw:image>
        </draw:frame>
      </text:p>
      <text:p text:style-name="Text_20_body">
        <draw:frame draw:style-name="fr2" draw:name="Bild3" text:anchor-type="as-char" svg:width="4.8cm" svg:height="2.4cm" draw:z-index="3">
          <draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADAAAAAYCAIAAAAzn+mLAAAANUlEQVR42mPQztlAI/SMLMAw6qBRB406aNRBow4addCog0YdNAgd9IyOYNRBow4addCIcxAAb4fwubOOsmoAAAAASUVORK5CYII=</office:binary-data></draw:image>
        </draw:frame>
      </text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="Bedingungen"/>Bedingungen</text:h>
      <text:p text:style-name="Text_20_body">Zahlbar binnen 30 Tagen ohne Abzug. Einzelheiten siehe <text:bookmark-ref text:reference-format="text" text:ref-name="Leistung">Leistung</text:bookmark-ref>, <text:sequence-ref text:reference-format="category-and-value" text:ref-name="refTable0">Tabelle 1</text:sequence-ref> und <text:sequence-ref text:reference-format="category-and-value" text:ref-name="refIllustration0">Abbildung 1</text:sequence-ref>; die Bedingungen stehen auf Seite <text:bookmark-ref text:reference-format="page" text:ref-name="Bedingungen">4</text:bookmark-ref>. Es gelten unsere <text:a xlink:type="simple" xlink:href="https://example.org/agb" text:style-name="Internet_20_link">AGB</text:a>. Prüfbefehl: <text:span text:style-name="Source_20_Text">hpro-check angebot.hpro</text:span>. <text:span text:style-name="Emphasis">Gültig bis 30. November 2026.</text:span><text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Endnote">Alle Preise ohne Umsatzsteuer.</text:p></text:note-body></text:note></text:p>
    </office:text>
  </office:body>
</office:document>
