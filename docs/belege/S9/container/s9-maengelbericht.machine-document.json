          "items": [
            {
              "term": "M1",
              "descriptions": [
                "Behebung bis 30. November 2026"
              ]
            },
            {
              "term": "M2",
              "descriptions": [
                "Sofort sichern, Behebung bis 31. Oktober 2026"
              ]
            },
            {
              "term": "M3",
              "descriptions": [
                "Behebung bis 15. April 2027"
              ]
            }
          ]
        },
        {
