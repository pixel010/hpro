  <office:body>
    <office:text>
      <text:sequence-decls>
        <text:sequence-decl text:display-outline-level="0" text:name="Abbildung"/>
        <text:sequence-decl text:display-outline-level="0" text:name="Tabelle"/>
      </text:sequence-decls>
      <text:p text:style-name="Title">Prüfbericht Dachstuhl Haus Nr. 12</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Zusammenfassung</text:h>
      <text:p text:style-name="Text_20_body">Der Dachstuhl ist tragfähig. An der Nordseite sind Sparren und Mauerbank zu feucht; die Sanierung kostet rund 6.700 Euro netto.</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="Befund"/>Befund<text:bookmark-end text:name="Befund"/></text:h>
      <text:p text:style-name="Text_20_body">Begehung am 9. Oktober 2026 mit dem Eigentümer. Die Holzfeuchte wurde an vier Punkten gemessen<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Messung mit Widerstandsmessgerät nach ÖNORM B 3802-2.</text:p></text:note-body></text:note>; die Werte stehen im Abschnitt <text:bookmark-ref text:reference-format="text" text:ref-name="Messwerte">Messwerte</text:bookmark-ref> und in <text:sequence-ref text:reference-format="category-and-value" text:ref-name="refTable0">Tabelle 1</text:sequence-ref>.</text:p>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Feuchteschäden</text:h>
      <text:p text:style-name="Text_20_body">Feuchteflecken am Sparren Nord und an der Mauerbank, siehe <text:sequence-ref text:reference-format="category-and-value" text:ref-name="refIllustration0">Abbildung 1</text:sequence-ref>.</text:p>
      <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="fr2" draw:name="Foto" text:anchor-type="as-char" svg:width="12cm" svg:height="7.5cm" draw:z-index="1"><draw:image draw:mime-type="image/png"><office:binary-data></office:binary-data></draw:image><svg:title>Foto des Dachstuhls von innen mit dunklen Feuchteflecken am Sparren Nord</svg:title><svg:desc>Foto des Dachstuhls von innen mit dunklen Feuchteflecken am Sparren Nord</svg:desc></draw:frame></text:p><text:p text:style-name="Illustration">Abbildung <text:sequence text:ref-name="refIllustration0" text:name="Abbildung" text:formula="ooow:Abbildung+1" style:num-format="1">1</text:sequence>: Dachstuhl, Blick nach Norden</text:p>
      <text:list text:style-name="List_20_1"><text:list-item><text:p text:style-name="List_20_Contents">Sparren Nord</text:p><text:list><text:list-item><text:p text:style-name="List_20_Contents">Flecken auf 1,2 m Länge</text:p></text:list-item><text:list-item><text:p text:style-name="List_20_Contents">Oberfläche weich</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="List_20_Contents">Mauerbank Nord</text:p></text:list-item><text:list-item><text:p text:style-name="List_20_Contents">Pfette, nur im Randbereich</text:p></text:list-item></text:list>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Holzschädlinge</text:h>
      <text:p text:style-name="Text_20_body">Kein Befall durch Hausbock oder Anobien festgestellt.</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="Messwerte"/>Messwerte<text:bookmark-end text:name="Messwerte"/></text:h>
      <text:p text:style-name="Text_20_body">Gemessen in 2 cm Tiefe bei 8 °C Lufttemperatur<text:note text:id="ftn2" text:note-class="footnote"><text:note-citation>2</text:note-citation><text:note-body><text:p text:style-name="Footnote">Grenzwert für tragendes Bauholz: 20 Prozent Holzfeuchte.</text:p></text:note-body></text:note>.</text:p>
      <table:table table:name="Messwerte_Tabelle" table:style-name="Tab">
        <table:table-column table:number-columns-repeated="4"/>
        <table:table-header-rows><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Messpunkt</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Bauteil</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Holzfeuchte %</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Bewertung</text:p></table:table-cell></table:table-row></table:table-header-rows>
        <table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">M1</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Sparren Nord</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">24</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">zu feucht</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">M2</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Sparren Süd</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">14</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">in Ordnung</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">M3</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Pfette</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">19</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Grenzwert</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">M4</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Mauerbank</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">27</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">zu feucht</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Table">Tabelle <text:sequence text:ref-name="refTable0" text:name="Tabelle" text:formula="ooow:Tabelle+1" style:num-format="1">1</text:sequence>: Holzfeuchte je Messpunkt</text:p>
      <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="fr2" draw:name="Diagramm" text:anchor-type="as-char" svg:width="12cm" svg:height="7.5cm" draw:z-index="2"><draw:image draw:mime-type="image/png"><office:binary-data></office:binary-data></draw:image><svg:title>Balkendiagramm der Holzfeuchte: M1 24 %, M2 14 %, M3 19 %, M4 27 %</svg:title><svg:desc>Balkendiagramm der Holzfeuchte: M1 24 %, M2 14 %, M3 19 %, M4 27 %</svg:desc></draw:frame></text:p><text:p text:style-name="Illustration">Abbildung <text:sequence text:ref-name="refIllustration1" text:name="Abbildung" text:formula="ooow:Abbildung+1" style:num-format="1">2</text:sequence>: Holzfeuchte je Messpunkt</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Kosten</text:h>
      <table:table table:name="Kosten" table:style-name="Tab">
        <table:table-column table:number-columns-repeated="3"/>
        <table:table-header-rows><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Gewerk</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Leistung</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Heading">Betrag</text:p></table:table-cell></table:table-row></table:table-header-rows>
        <table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Zimmerei</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Sparren ersetzen</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">4.800,00</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string" table:number-rows-spanned="2"><text:p text:style-name="Table_20_Contents">Spengler</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Rinne erneuern</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">1.250,00</text:p></table:table-cell></table:table-row><table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">Anschluss Kamin</text:p></table:table-cell><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">640,00</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Zelle" office:value-type="string" table:number-columns-spanned="2"><text:p text:style-name="Table_20_Contents">Summe netto</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Zelle" office:value-type="string"><text:p text:style-name="Table_20_Contents">6.690,00</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Table">Tabelle <text:sequence text:ref-name="refTable1" text:name="Tabelle" text:formula="ooow:Tabelle+1" style:num-format="1">2</text:sequence>: Kosten der Sanierung in Euro</text:p>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Empfehlung</text:h>
      <text:p text:style-name="Text_20_body">Die feuchten Bauteile sind zu trocknen oder zu ersetzen. Normen und Merkblätter: <text:a xlink:type="simple" xlink:href="https://www.austrian-standards.at/" text:style-name="Internet_20_link">Austrian Standards</text:a>.</text:p>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Sofortmaßnahmen</text:h>
      <text:list text:style-name="Numbering_20_123">
        <text:list-item><text:p text:style-name="List_20_Contents">Rinne an der Nordseite abdichten</text:p></text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Sparren Nord abstützen<text:note text:id="ftn3" text:note-class="footnote"><text:note-citation>3</text:note-citation><text:note-body><text:p text:style-name="Footnote">Abstützung nach Angabe des Statikers vom 10. Oktober 2026.</text:p></text:note-body></text:note></text:p></text:list-item>
        <text:list-item><text:p text:style-name="List_20_Contents">Raum täglich lüften</text:p></text:list-item>
      </text:list>
      <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="fr2" draw:name="Zierlinie" draw:decorative="true" text:anchor-type="as-char" svg:width="15cm" svg:height="0.2cm" draw:z-index="2"><draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAlgAAAAICAIAAACqFRZVAAAAQ0lEQVR4nO3awQ3AQAwCsKZTZ/vcGDywJ+CHkJi7+wCg1Z8OAABJihCAarO76QwAEGMRAlBtnGUAaGYRAlBNEQJQ7QF8IQdwxDE5UQAAAABJRU5ErkJggg==</office:binary-data></draw:image></draw:frame></text:p>
      <text:p text:style-name="Text_20_body">Innsbruck, 13. Oktober 2026</text:p>
    </office:text>
  </office:body>
