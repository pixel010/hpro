{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reisekostenabrechnung – Daten des Formulars „abrechnung“",
  "description": "Datenobjekt nach HPC-0009: Formular, Dokument, Status und Werte aller Felder. Ein Entwurf darf leere Werte (null) haben; eine abgesendete Abrechnung muss $defs/vollstaendig erfüllen.",
  "type": "object",
  "required": [
    "form",
    "status",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "form": {
      "const": "abrechnung"
    },
    "document": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f-]{36}$"
    },
    "status": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "submittedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "values": {
      "$ref": "#/$defs/werte"
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "submitted"
      }
    }
  },
  "then": {
    "required": [
      "submittedAt"
    ],
    "properties": {
      "values": {
        "$ref": "#/$defs/vollstaendig"
      }
    }
  },
  "$defs": {
    "werte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "personalnummer",
        "abteilung",
        "zweck",
        "ziel",
        "reisetag",
        "dauer_stunden",
        "tagesgeld",
        "anreise",
        "kennzeichen",
        "kilometer",
        "kilometergeld",
        "fahrkarten",
        "parken",
        "sonstige_auslagen",
        "vorschuss",
        "summe",
        "auszahlung",
        "iban",
        "angaben_richtig"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "personalnummer": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}$"
        },
        "abteilung": {
          "enum": [
            "bau",
            "wasser",
            "verwaltung",
            null
          ]
        },
        "zweck": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "ziel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "reisetag": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dauer_stunden": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 24
        },
        "tagesgeld": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "anreise": {
          "enum": [
            "oeffentlich",
            "pkw",
            null
          ]
        },
        "kennzeichen": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12
        },
        "kilometer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2000
        },
        "kilometergeld": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fahrkarten": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "parken": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sonstige_auslagen": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vorschuss": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "summe": {
          "type": "number"
        },
        "auszahlung": {
          "type": "number"
        },
        "iban": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AT[0-9]{2}( ?[0-9]{4}){4}$"
        },
        "angaben_richtig": {
          "type": "boolean"
        }
      }
    },
    "vollstaendig": {
      "description": "Werte einer abgesendeten Abrechnung: Pflichtangaben gefüllt.",
      "required": [
        "name",
        "personalnummer",
        "abteilung",
        "zweck",
        "ziel",
        "reisetag",
        "dauer_stunden",
        "anreise",
        "iban",
        "angaben_richtig"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "personalnummer": {
          "type": "string"
        },
        "abteilung": {
          "type": "string"
        },
        "zweck": {
          "type": "string",
          "minLength": 1
        },
        "ziel": {
          "type": "string",
          "minLength": 1
        },
        "reisetag": {
          "type": "string"
        },
        "dauer_stunden": {
          "type": "integer"
        },
        "anreise": {
          "type": "string"
        },
        "iban": {
          "type": "string"
        },
        "angaben_richtig": {
          "const": true
        },
        "summe": {
          "type": "number",
          "minimum": 0
        },
        "auszahlung": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
