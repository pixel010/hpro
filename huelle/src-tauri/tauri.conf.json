{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hpro-reader",
  "mainBinaryName": "hpro-reader",
  "version": "0.1.0",
  "identifier": "org.hpro.reader",
  "build": {
    "frontendDist": "../dist-web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "hpro Reader",
        "width": 1200,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": true,
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "hpro Reader",
    "longDescription": "Liest, bearbeitet und signiert hpro-Dokumente: Information für Bildschirme, Druck nach DIN A4 als abgeleitete Ausgabe.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hpro-dienst"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hpro"
        ],
        "name": "hpro-Dokument",
        "description": "hpro-Dokument",
        "mimeType": "application/vnd.hpro+zip",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/mime/packages/hpro-reader.xml": "linux/hpro-mime.xml"
        },
        "desktopTemplate": "linux/hpro-reader.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
