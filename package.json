{
  "name": "html-pro",
  "version": "0.1.0",
  "private": true,
  "description": "html-Pro: Reader und Editor für Dokumente jenseits des Papierformats",
  "workspaces": [
    "kern"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && npm run spec:check && npm run spec:selftest && npm run konf:check && npm run konf:selftest && npm run form:check && npm run form:selftest && npm run gov:check && npm run gov:selftest",
    "gov:check": "node scripts/check-governance.mjs",
    "gov:selftest": "node scripts/check-governance-selftest.mjs",
    "gov:beispiele": "node scripts/s4-beispiele.mjs",
    "gov:erweiterung": "node scripts/check-erweiterung.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "spec:selftest": "node scripts/check-spec-selftest.mjs",
    "konf:check": "node scripts/check-konformitaet.mjs",
    "konf:selftest": "node scripts/check-konformitaet-selftest.mjs",
    "konf:export": "node scripts/check-konformitaet.mjs --write-tables && node scripts/check-konformitaet.mjs --export",
    "konf:bericht": "node scripts/konformitaet-bericht.mjs",
    "form:check": "node scripts/check-formeln.mjs",
    "form:selftest": "node scripts/check-formeln-selftest.mjs",
    "form:export": "node scripts/check-formeln.mjs --export",
    "form:referenzwerte": "node scripts/formeln-referenzwerte.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
